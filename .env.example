# ReachSurge 环境变量模板
# 用法：复制本文件为 .env（cp .env.example .env），按需填值。
# 或通过 MCP 客户端 env 段 / LEADGEN_ENV_FILE 指向的额外 .env 注入。
# 标 [必填] 的不配则对应功能直接不可用；标 [可选] 的留空走代码默认值。

# ── [必填] 大模型（精度过滤 / 公司画像 / 产品词提取都依赖它）──
# 不配则所有 LLM 相关功能降级或报错
DEEPSEEK_API_KEY=your_deepseek_api_key
# 以下两个有默认值，多数情况无需改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── [可选] 数据源 key（不配则对应源自动降级，不影响其他源）──
# Hunter：邮箱富集 + Discover 找公司
HUNTER_API_KEY=your_hunter_api_key
# SerpApi Google Maps 经销商源；多 key 逗号分隔，号池轮换
SERPAPI_API_KEYS=your_serpapi_key1,your_serpapi_key2
# Tavily 展会展商搜索；多 key 逗号分隔，号池轮换
TAVILY_API_KEYS=tvly-your_tavily_key1,tvly-your_tavily_key2
# 仅 europages 过 Cloudflare WAF 需要；留空则回退读取 ~/.capsolver_key
CAPSOLVER_API_KEY=your_capsolver_api_key

# ── [可选] 代理（出口 IP 受限的数据源需要：社交、海关、展会等）──
# 大小写两套都配，兼容只认其中一套的库（requests 认小写，httpx/subprocess 多认大写）
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890
http_proxy=http://127.0.0.1:7890
# LEADGEN_PROXY 优先级高于 HTTPS_PROXY，专门给 europages/gosom/customs/scout 等源用
# 留空则回退 HTTPS_PROXY（无任何代理 env 则直连）
LEADGEN_PROXY=

# gosom 经销商源的二进制路径；留空则用项目内 bin/google_maps_scraper
# 需自行下载 gosom 的 google_maps_scraper 二进制；无则该源在 search() 报错降级
GOSOM_BIN=

# ── [可选] 数据目录与凭证加密（不设则用默认路径 / 首次自动生成）──
# SQLite 与知识库存储目录；留空则用仓库下 data/sqlite/
LEADGEN_DATA_DIR=
# 凭证加密密钥（urlsafe base64 Fernet key）；留空则首次自动生成并写入固定路径
LEADGEN_FERNET_KEY=
# 额外的 .env 文件绝对路径，启动时 load_dotenv 注入（MCP 子进程透传受限时用）；留空不加载
LEADGEN_ENV_FILE=

# ── [可选] 邮箱 watchdog（仅 bin/inbox_watchdog.py 用，MCP 主服务不需要）──
# cron 拉收件箱时用的飞书 open_id；不跑 watchdog 可忽略
REACHSURGE_USER_ID=
