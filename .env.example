# ReachSurge 环境变量模板
# 用法：复制本文件为 .env（cp .env.example .env），按需填值。
# 或通过 MCP 客户端 env 段 / LEADGEN_ENV_FILE 指向的额外 .env 注入。
# 所有变量都可留空启动；不配 Key 时只停用对应的第三方能力。

# ── [可选] 大模型（精度过滤 / 公司画像 / 产品词提取使用）──
# 不配则相关功能降级，不影响 MCP 启动与本地能力
DEEPSEEK_API_KEY=
# 以下两个有默认值，多数情况无需改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── [可选] 数据源 key（不配则对应源自动降级，不影响其他源）──
# Hunter：邮箱富集 + Discover 找公司
HUNTER_API_KEY=
# SerpApi Google Maps 经销商源；多 key 逗号分隔，号池轮换
SERPAPI_API_KEYS=
# Tavily 展会展商搜索；多 key 逗号分隔，号池轮换
TAVILY_API_KEYS=
# 仅 europages 过 Cloudflare WAF 需要；留空则回退读取 ~/.capsolver_key
CAPSOLVER_API_KEY=

# ── [可选] 代理（出口 IP 受限的数据源需要：社交、海关、展会等）──
# 大小写两套都配，兼容只认其中一套的库（requests 认小写，httpx/subprocess 多认大写）
HTTPS_PROXY=
HTTP_PROXY=
https_proxy=
http_proxy=
# LEADGEN_PROXY 优先级高于 HTTPS_PROXY，专门给 europages/gosom/customs/scout 等源用
# 留空则回退 HTTPS_PROXY（无任何代理 env 则直连）
LEADGEN_PROXY=

# gosom 经销商源的二进制路径；留空则用项目内 bin/google_maps_scraper
# 需自行下载 gosom 的 google_maps_scraper 二进制；无则该源在 search() 报错降级
GOSOM_BIN=

# ── [可选] 数据目录与凭证加密（不设则用默认路径 / 首次自动生成）──
# 运行数据根目录；SQLite 写在 sqlite/，知识库写在 knowledge/，加密密钥写在根目录。
# 留空时使用系统用户数据目录（macOS/Windows/Linux 各自的标准位置）。
LEADGEN_DATA_DIR=
# 凭证加密密钥（urlsafe base64 Fernet key）；留空则首次自动生成并写入固定路径
LEADGEN_FERNET_KEY=
# 额外的 .env 文件绝对路径，启动时 load_dotenv 注入（MCP 子进程透传受限时用）；留空不加载
LEADGEN_ENV_FILE=

# 本地数据命名空间（不是登录账号/认证身份）；留空默认为 default
REACHSURGE_USER_ID=default
# 高级兼容开关：允许每次工具调用自行选择 user_id。它不提供认证，普通用户不要开启。
REACHSURGE_ALLOW_USER_NAMESPACES=0
# 当前 MCP 进程内，每个命名空间最多并行的后台搜索/邮箱富集任务数（1-8）
REACHSURGE_MAX_ACTIVE_TASKS=2

# ── [高风险可选] 真发信 / 收件箱 ──
# 请使用邮箱“应用专用密码”，不要把邮箱密码发给 Agent 或写进 MCP 客户端配置。
# send_email 还会强制要求每次调用 confirm_send=true，并执行服务端每日硬上限。
REACHSURGE_ENABLE_SEND_EMAIL=0
REACHSURGE_DAILY_SEND_LIMIT=30
REACHSURGE_SMTP_HOST=
REACHSURGE_SMTP_PORT=587
REACHSURGE_SMTP_USER=
REACHSURGE_SMTP_PASSWORD=
REACHSURGE_ENABLE_CHECK_INBOX=0
REACHSURGE_IMAP_HOST=
REACHSURGE_IMAP_PORT=993
REACHSURGE_IMAP_USER=
REACHSURGE_IMAP_PASSWORD=
# 拉取整封邮件前先检查服务端报告的大小；默认上限 5 MiB
REACHSURGE_MAX_EMAIL_BYTES=5242880

# 默认阻止网站抓取访问 localhost/私网，降低 SSRF 风险。
# 只有明确需要抓内网站点时才改为 1；不建议普通用户开启。
REACHSURGE_ALLOW_PRIVATE_NETWORK=0

# ── [可选] 邮箱 watchdog（仅 bin/inbox_watchdog.py 用）──
# watchdog 复用上面的 REACHSURGE_USER_ID；不运行可忽略。
